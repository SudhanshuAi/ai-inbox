{
  "name": "ai-knowledge-inbox",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@ai-inbox/api",
    "dev:web": "npm run dev --workspace=@ai-inbox/web",
    "dev": "concurrently -k -n API,WEB -c indigo,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "build:contracts": "npm run build --workspace=@ai-inbox/contracts",
    "build:api": "npm run build --workspace=@ai-inbox/api",
    "build:web": "npm run build --workspace=@ai-inbox/web",
    "build": "npm run build:contracts && npm run build:api && npm run build:web",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
