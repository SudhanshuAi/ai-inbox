# ── Required (Set at least ONE API key) ─────────────────────────────────────────

# Option A: Google Gemini API Key (Recommended — free tier, handles both chat + embeddings)
GEMINI_API_KEY=your-gemini-api-key-here

# Option B: OpenAI API Key (handles both chat + embeddings)
# OPENAI_API_KEY=sk-your-openai-key-here

# Option C: Groq API Key (ultra-fast chat via Llama 3.3) + Gemini or OpenAI for embeddings
# NOTE: Groq does not support embeddings. You MUST also set GEMINI_API_KEY or OPENAI_API_KEY.
# GROQ_API_KEY=gsk_your-groq-key-here
# GEMINI_API_KEY=your-gemini-api-key-here   <-- also needed for embeddings when using Groq

# AI Provider Selection:
#   'auto'   → Groq (if set) > Gemini (if set) > OpenAI   [default]
#   'groq'   → Use Groq for chat, Gemini/OpenAI for embeddings
#   'gemini' → Use Gemini for both chat and embeddings
#   'openai' → Use OpenAI for both chat and embeddings
AI_PROVIDER=auto

# ── Optional Overrides ─────────────────────────────────────────────────────────
# Server
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (path to SQLite file)
SQLITE_PATH=./data/knowledge.db

# AI Models (Auto-configured based on provider if left blank)
# Gemini defaults:  EMBEDDING_MODEL=gemini-embedding-001  CHAT_MODEL=gemini-3.6-flash
# OpenAI defaults:  EMBEDDING_MODEL=text-embedding-3-small  CHAT_MODEL=gpt-4o-mini
# Groq defaults:    EMBEDDING_MODEL=gemini-embedding-001  CHAT_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=
# CHAT_MODEL=

# Fetch limits
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5

# Input limits
MAX_NOTE_LENGTH=100000
MAX_QUESTION_LENGTH=2000

# Chunking (characters)
CHUNK_TARGET_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_PER_ITEM_CAP=2
RETRIEVAL_RELEVANCE_THRESHOLD=0.3
RETRIEVAL_CONTEXT_BUDGET_CHARS=8000

# Logging
LOG_LEVEL=info
