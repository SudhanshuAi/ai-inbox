# ── Required (Set at least ONE API key) ─────────────────────────────────────────
# Option A: Google Gemini API Key (Recommended if you don't have OpenAI key)
GEMINI_API_KEY=your-gemini-api-key-here

# Option B: OpenAI API Key
# OPENAI_API_KEY=sk-your-openai-key-here

# AI Provider Selection: 'auto' (default), 'gemini', or 'openai'
AI_PROVIDER=auto

# ── Optional Overrides ─────────────────────────────────────────────────────────
# Server
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (path to SQLite file)
SQLITE_PATH=./data/knowledge.db

# AI Models (Auto-configured based on provider if left blank)
# For Gemini: EMBEDDING_MODEL=text-embedding-004, CHAT_MODEL=gemini-1.5-flash
# For OpenAI: EMBEDDING_MODEL=text-embedding-3-small, CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-004
# CHAT_MODEL=gemini-1.5-flash

# Fetch limits
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5

# Input limits
MAX_NOTE_LENGTH=100000
MAX_QUESTION_LENGTH=2000

# Chunking (characters)
CHUNK_TARGET_CHARS=1500
CHUNK_OVERLAP_CHARS=200

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_PER_ITEM_CAP=2
RETRIEVAL_RELEVANCE_THRESHOLD=0.3
RETRIEVAL_CONTEXT_BUDGET_CHARS=8000

# Logging
LOG_LEVEL=info
